model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: da-DK
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Server","Source Master DB","f_Ola Command Log","f_Collector Runs","f_File IO","f_MissingIndex","f_Server Resource","f_Wait Stats"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'f_Ola Command Log'
ref table 'f_Collector Runs'
ref table 'f_File IO'
ref table f_MissingIndex
ref table 'f_Server Resource'
ref table 'f_Wait Stats'

ref cultureInfo en-US

